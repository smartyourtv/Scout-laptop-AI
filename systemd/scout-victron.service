[Unit]
Description=Victron BLE listener (SmartSolar + Orion)
After=network.target sound.target

[Service]
Type=simple
User=scout
WorkingDirectory=/home/hatch/scout
ExecStart=/home/hatch/scout/venv/bin/python /home/hatch/scout/victron_listener.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
