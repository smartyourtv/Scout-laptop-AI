[Unit]
Description=Scout brain (llama-server, main model, port 8080)
After=network.target sound.target

[Service]
Type=simple
User=scout
WorkingDirectory=/home/hatch/scout
ExecStart=/home/hatch/scout/venv/bin/python /home/hatch/scout/talk.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
